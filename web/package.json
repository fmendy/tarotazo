{
  "name": "arcana-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "dev:mock": "vite --mode mock",
    "build:app": "tsc -b && vite build --mode app",
    "cap:sync": "npm run build:app && cap sync android",
    "android:debug": "npm run cap:sync && node scripts/gradle.mjs assembleDebug",
    "android:release": "npm run cap:sync && node scripts/gradle.mjs bundleRelease",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.1",
    "i18next": "^27.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  }
}
