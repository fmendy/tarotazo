{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcana.tarotazo/schemas/titles.schema.json",
  "title": "{lang}/titles.json — diplomas de la vidente",
  "type": "object",
  "additionalProperties": false,
  "required": ["titles"],
  "properties": {
    "$comment": { "type": "string" },
    "titles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "titulo", "centro", "comentario", "sello", "anio", "frame"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/slug" },
          "titulo": { "type": "string", "minLength": 1 },
          "centro": { "type": "string", "minLength": 1 },
          "comentario": { "$ref": "common.schema.json#/$defs/text" },
          "sello": { "type": "string", "minLength": 1 },
          "anio": { "type": "integer", "minimum": 1000, "maximum": 2100 },
          "frame": { "enum": ["barroco", "dorado", "madera", "moderno", "pergamino"] }
        }
      }
    }
  }
}
