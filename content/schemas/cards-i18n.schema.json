{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcana.tarotazo/schemas/cards-i18n.schema.json",
  "title": "{lang}/cards/{familia}.json — nombres visibles de baraja, modelos, palos y cartas",
  "type": "object",
  "additionalProperties": false,
  "required": ["family", "name", "description", "suits", "models", "cards"],
  "properties": {
    "$comment": { "type": "string" },
    "family": { "$ref": "common.schema.json#/$defs/family" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "suits": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/suit" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "models": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/model" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "cardNames": {
            "type": "object",
            "description": "Nombres que cambian en este modelo (p. ej. Marsella: La Papisa).",
            "propertyNames": { "$ref": "common.schema.json#/$defs/cardId" },
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "cards": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/cardId" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
